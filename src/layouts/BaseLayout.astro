---
import BaseHead from '../components/BaseHead.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	openGraphType?: 'website' | 'article';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	openGraphType = 'website',
} = Astro.props;
const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} image={image} openGraphType={openGraphType} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳至主要內容</a>
		<Header />
		<slot />
		<Footer />
		{measurementId && <AnalyticsConsent measurementId={measurementId} />}
	</body>
</html>
