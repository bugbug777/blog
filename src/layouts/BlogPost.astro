---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CATEGORY_LABELS, sitePath } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug: string };

const { title, description, pubDate, updatedDate, heroImage, category, draft, slug } = Astro.props;
const socialImage = heroImage
	? (await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover' })).src
	: '/og-image.png';
const canonicalURL = new URL(sitePath(`/blog/${slug}/`), Astro.site);
const structuredData = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: 'Sihle', url: new URL(sitePath('/about/'), Astro.site).href },
	mainEntityOfPage: canonicalURL.href,
	image: new URL(sitePath(socialImage), Astro.site).href,
}).replace(/</g, '\\u003c');
---

<BaseLayout
	title={`${title}｜Sihle’s Studio`}
	description={description}
	image={socialImage}
	openGraphType="article"
>
	<script type="application/ld+json" set:html={structuredData} />
	<main id="main-content" class="post-main">
		<article>
			<a class="back-link" href={sitePath('/blog/')}>← 回到文章列表</a>
			<header class="post-header">
				<div class="post-meta">
					<span class="category">{CATEGORY_LABELS[category]}</span>
					<FormattedDate date={pubDate} />
					{updatedDate && <span>更新於 <FormattedDate date={updatedDate} /></span>}
					{draft && <span class="draft-label">本機草稿</span>}
				</div>
				<h1>{title}</h1>
				<p class="description">{description}</p>
			</header>
			{heroImage && (
				<div class="hero-image">
					<Image src={heroImage} alt="" width={1020} height={510} />
				</div>
			)}
			<div class="prose">
				<slot />
			</div>
			<footer class="post-footer">
				<a class="back-link" href={sitePath('/blog/')}>← 繼續閱讀其他文章</a>
			</footer>
		</article>
	</main>
</BaseLayout>

<style>
	.post-main {
		width: min(100% - 2.5rem, var(--content-width));
	}
	.back-link {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 0.86rem;
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent-strong);
	}
	.post-header {
		margin-bottom: 2.25rem;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.8rem;
		margin-bottom: 1rem;
		color: var(--muted);
		font-size: 0.82rem;
	}
	.category {
		color: var(--accent-strong);
		font-weight: 700;
	}
	.draft-label {
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
		background: var(--surface-soft);
		font-size: 0.72rem;
	}
	.post-header h1 {
		max-width: none;
		font-size: clamp(2rem, 4vw, 3.25rem);
		line-height: 1.22;
		letter-spacing: -0.035em;
		text-wrap: balance;
		text-align: justify;
		text-align-last: justify;
	}
	.description {
		max-width: 38rem;
		margin: 1.15rem 0 0;
		color: var(--muted);
		font-size: 1rem;
	}
	.hero-image {
		margin: 2rem 0 3rem;
	}
	.hero-image img {
		display: block;
		width: 100%;
		max-height: 460px;
		border-radius: 14px;
		object-fit: cover;
	}
	.prose {
		max-width: none;
		margin: 0;
		font-size: 1.04rem;
	}
	.post-footer {
		margin-top: 4rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
	@media (max-width: 620px) {
		.post-main {
			width: min(100% - 1.5rem, var(--content-width));
		}
		.post-header {
			margin-bottom: 1.75rem;
		}
		.post-header h1 {
			font-size: clamp(2rem, 8vw, 2.65rem);
		}
	}
</style>
