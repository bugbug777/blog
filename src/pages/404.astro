---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, sitePath } from '../consts';
---

<BaseLayout title={`找不到頁面｜${SITE_TITLE}`} description="這個頁面不存在，請回到首頁或瀏覽文章。">
	<main id="main-content" class="not-found">
		<p class="eyebrow">404 · Not found</p>
		<h1>這一頁暫時找不到。</h1>
		<p>網址可能已變更，或頁面尚未建立。你可以回到首頁，或從文章列表繼續閱讀。</p>
		<div class="actions">
			<a href={sitePath('/')}>回到首頁</a>
			<a href={sitePath('/blog/')}>瀏覽文章</a>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found h1 {
		font-size: clamp(2.4rem, 8vw, 4rem);
	}
	.not-found > p:not(.eyebrow) {
		max-width: 35rem;
		margin: 1rem 0 1.5rem;
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.actions a {
		font-weight: 700;
	}
</style>
