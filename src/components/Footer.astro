---
import { SITE_EMAIL, SITE_TITLE, THREADS_URL, sitePath } from '../consts';

const year = new Date().getFullYear();
const hasAnalytics = Boolean(import.meta.env.PUBLIC_GA4_ID?.trim());
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>© {year} {SITE_TITLE}</p>
		<nav aria-label="頁尾導覽">
			<a href={sitePath('/privacy/')}>隱私權</a>
			{hasAnalytics && <button type="button" data-open-analytics-settings>Analytics 設定</button>}
			<a href={`mailto:${SITE_EMAIL}`}>Email</a>
			<a href={THREADS_URL} target="_blank" rel="me noopener noreferrer">Threads</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		color: var(--muted);
	}
	.footer-inner {
		width: min(100% - 2.5rem, 1120px);
		min-height: 88px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.82rem;
	}
	.footer-inner p {
		margin: 0;
	}
	.footer-inner nav {
		display: flex;
		gap: 1rem;
	}
	.footer-inner a {
		color: var(--muted);
		text-decoration: none;
	}
	.footer-inner button {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
		font: inherit;
		cursor: pointer;
	}
	.footer-inner a:hover {
		color: var(--accent-strong);
	}
	.footer-inner button:hover {
		color: var(--accent-strong);
	}
	@media (max-width: 620px) {
		.footer-inner {
			width: min(100% - 1.5rem, 1120px);
			align-items: flex-start;
			flex-direction: column;
			justify-content: center;
			padding: 1.25rem 0;
		}
	}
</style>
