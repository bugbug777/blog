---
import { SITE_TITLE, sitePath } from '../consts';
---

<header class="site-header">
	<nav class="site-nav" aria-label="主要導覽">
		<a class="brand" href={sitePath('/')}>{SITE_TITLE}</a>
		<div class="nav-links">
			<a href={sitePath('/')}>首頁</a>
			<a href={sitePath('/blog/')}>文章</a>
			<a href={sitePath('/about/')}>關於</a>
		</div>
		<button class="theme-toggle" type="button" aria-label="切換深色模式" aria-pressed="false">
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42m-9.88 9.88-1.42 1.42M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" />
			</svg>
			<span class="theme-toggle-label">深色模式</span>
		</button>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

	if (toggle) {
		const syncTheme = () => {
			const isDark = document.documentElement.dataset.theme === 'dark';
			toggle.setAttribute('aria-pressed', String(isDark));
			toggle.setAttribute('aria-label', isDark ? '切換明亮模式' : '切換深色模式');
			const label = toggle.querySelector('.theme-toggle-label');
			if (label) label.textContent = isDark ? '明亮模式' : '深色模式';
		};

		syncTheme();
		toggle.addEventListener('click', () => {
			const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			if (nextTheme === 'light') delete document.documentElement.dataset.theme;
			else document.documentElement.dataset.theme = nextTheme;
			try {
				localStorage.setItem('sihles-studio-theme', nextTheme);
			} catch {}
			syncTheme();
		});
	}
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}
	.site-nav {
		width: min(100% - 2.5rem, 1120px);
		min-height: 76px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 2.5rem;
	}
	.brand {
		font-family: var(--font-atkinson), Georgia, serif;
		font-size: 1.18rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.55rem;
		margin-left: auto;
	}
	.nav-links a {
		color: var(--muted);
		font-size: 0.92rem;
		text-decoration: none;
	}
	.nav-links a:hover,
	.nav-links a:focus-visible {
		color: var(--accent-strong);
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
	}
	.theme-toggle svg {
		width: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
	}
	@media (max-width: 620px) {
		.site-nav {
			width: min(100% - 1.5rem, 1120px);
			min-height: 68px;
			gap: 0.75rem;
			flex-wrap: wrap;
			padding: 0.7rem 0;
		}
		.brand {
			margin-right: auto;
		}
		.nav-links {
			order: 3;
			width: 100%;
			gap: 1.1rem;
			margin: 0;
		}
		.theme-toggle {
			padding: 0.45rem 0.55rem;
		}
	}
</style>
